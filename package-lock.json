{
  "name": "semark-repo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "semark-repo",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/semark": {
      "resolved": "packages/semark",
      "link": true
    },
    "node_modules/semark-mcp": {
      "resolved": "packages/mcp",
      "link": true
    },
    "packages/mcp": {
      "name": "semark-mcp",
      "version": "0.8.1",
      "license": "Apache-2.0",
      "dependencies": {
        "semark": "0.8.1"
      },
      "bin": {
        "semark-mcp": "server.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/semark": {
      "version": "0.8.1",
      "license": "Apache-2.0",
      "bin": {
        "semark": "bin/semark.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
